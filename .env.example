# Copy to Web/.env.local
# Backend API base (server-side only; browsers never call it directly)
API_URL=http://127.0.0.1:4000
# Map tiles for the live map. Default is OpenStreetMap (dev only). For production use a licensed provider.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
